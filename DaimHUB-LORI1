--============================================================
-- FLY LOGIC
--============================================================
local function clampSpeed(v)
    v = tonumber(v) or 50
    if v < CONFIG.MinFlySpeed then v = CONFIG.MinFlySpeed end
    if v > CONFIG.MaxFlySpeed then v = CONFIG.MaxFlySpeed end
    return v
end

local function updateSpeedUI(v)
    State.FlySpeed = v
    SpeedBox.Text = tostring(v)
    SpeedTitle.Text = "KECEPATAN: " .. tostring(v)
    SpeedBarFill.Size = UDim2.new(v / CONFIG.MaxFlySpeed, 0, 1, 0)
end

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if State.FlyBV then State.FlyBV:Destroy() end
    if State.FlyBG then State.FlyBG:Destroy() end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "DaimHUB_FlyBV"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp
    State.FlyBV = bv

    local bg = Instance.new("BodyGyro")
    bg.Name = "DaimHUB_FlyBG"
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 1000
    bg.D = 50
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp
    State.FlyBG = bg

    hum.PlatformStand = true

    if State.FlyConn then State.FlyConn:Disconnect() end
    State.FlyConn = RunService.RenderStepped:Connect(function()
        if not State.FlyActive then return end
        local c = LocalPlayer.Character
        if not c then return end
        local r = c:FindFirstChild("HumanoidRootPart")
        if not r or not State.FlyBV then return end

        local cam = workspace.CurrentCamera
        local move = Vector3.zero
        local speed = State.FlySpeed

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end

        if move.Magnitude > 0 then
            State.FlyBV.Velocity = move.Unit * speed
        else
            State.FlyBV.Velocity = Vector3.zero
        end
        if State.FlyBG then State.FlyBG.CFrame = cam.CFrame end
    end)
end

local function stopFly()
    if State.FlyConn then State.FlyConn:Disconnect() State.FlyConn = nil end
    if State.FlyBV then State.FlyBV:Destroy() State.FlyBV = nil end
    if State.FlyBG then State.FlyBG:Destroy() State.FlyBG = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

local function setFly(on)
    State.FlyActive = on
    if on then
        startFly()
        TweenService:Create(FlyToggle, TweenInfo.new(0.2), {
            BackgroundColor3 = CONFIG.AccentColor
        }):Play()
        TweenService:Create(FlyKnob, TweenInfo.new(0.2), {
            Position = UDim2.new(1, -19, 0.5, -8)
        }):Play()
    else
        stopFly()
        TweenService:Create(FlyToggle, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(50, 45, 65)
        }):Play()
        TweenService:Create(FlyKnob, TweenInfo.new(0.2), {
            Position = UDim2.new(0, 3, 0.5, -8)
        }):Play()
    end
end

