    "cerberus", "moby", "beluga", "dragon", "skeleton", "oni",
    "gorilla", "celestial", "demon", "hybrid", "scorpio",
    "froggo", "crawler", "crocodon", "krakenoid", "dreadscale",
}

local function isGuardian(obj)
    if not obj or not obj:IsA("Model") then return false end
    if obj == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    if nameMatch(obj.Name, GUARD_KW) then return true end
    for _, c in ipairs(obj:GetChildren()) do
        if nameMatch(c.Name, GUARD_KW) then return true end
    end
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") then
                local nm = d.Name:lower()
                if nm:find("ai") or nm:find("chase") or nm:find("attack")
                or nm:find("follow") or nm:find("target") then
                    return true
                end
            end
        end
    end
    return false
end

local function freezeGuardian(model)
    local hum = model:FindFirstChildOfClass("Humanoid")
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if hum then
        pcall(function()
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum.AutoRotate = false
        end)
    end
    if hrp then pcall(function() hrp.Anchored = true end) end
    for _, c in ipairs(model:GetDescendants()) do
        if c:IsA("BodyVelocity") or c:IsA("BodyGyro")
        or c:IsA("AlignPosition") or c:IsA("AlignOrientation") then
            pcall(function() c:Destroy() end)
        end
        if c:IsA("Script") or c:IsA("LocalScript") then
            local nm = c.Name:lower()
            if nm:find("ai") or nm:find("chase") or nm:find("attack")
            or nm:find("follow") or nm:find("target") then
                pcall(function() c.Disabled = true end)
            end
        end
        if c:IsA("BasePart") then
            local n = c.Name:lower()
            if n:find("hit") or n:find("damage") or n:find("bite")
            or n:find("mouth") or n:find("teeth") or n:find("attack")
            or n:find("kill") then
                pcall(function() c.CanTouch = false end)
            end
        end
        if c:IsA("Tool") then pcall(function() c.Parent = nil end) end
    end
    S.FrozenGuards[model] = true
end

local guardConn = nil
local function setGuard(on)
    S.GuardOn = on
    if on then
        if not guardConn then
            guardConn = RunService.Heartbeat:Connect(function()
                if not S.GuardOn then return end
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and isGuardian(obj) then
                        if not S.FrozenGuards[obj] then
                            freezeGuardian(obj)
                            print("[DaimHUB] Guardian frozen:", obj.Name)
                        else
                            local hum = obj:FindFirstChildOfClass("Humanoid")
                            if hum and hum.WalkSpeed ~= 0 then
                                pcall(function() hum.WalkSpeed = 0 end)
                            end
                            local hrp = obj:FindFirstChild("HumanoidRootPart")
                            if hrp and not hrp.Anchored then
                                pcall(function() hrp.Anchored = true end)
                            end
                        end
                    end
                end
            end)
        end
        print("[DaimHUB] Anti-Hit Guardian: ON")
    else
        if guardConn then guardConn:Disconnect() guardConn = nil end
        for model, _ in pairs(S.FrozenGuards) do
            local hum = model:FindFirstChildOfClass("Humanoid")
            local hrp = model:FindFirstChild("HumanoidRootPart")
            if hum then pcall(function() hum.WalkSpeed = 16 end) end
            if hrp then pcall(function() hrp.Anchored = false end) end
        end
        S.FrozenGuards = {}
        print("[DaimHUB] Anti-Hit Guardian: OFF")
    end
end

