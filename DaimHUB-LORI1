--============================================================
local function showStatus(text, isError)
    StatusLbl.Text = text
    StatusLbl.TextColor3 = isError and CONFIG.ErrorColor or CONFIG.SuccessColor
end

local function shake(inst)
    local orig = inst.Position
    for i = 1, 4 do
        inst.Position = orig + UDim2.fromOffset(8, 0)
        task.wait(0.04)
        inst.Position = orig - UDim2.fromOffset(8, 0)
        task.wait(0.04)
    end
    inst.Position = orig
end

local function runLoading(onDone)
    LoginPage.Visible = false
    LoadingPage.Visible = true

    local steps = {
        "Menghubungkan ke NEXORA...",
        "Memverifikasi key...",
        "Memuat modul Portal TV...",
        "Memuat modul Fly...",
        "Sinkronisasi dengan server...",
        "Hampir selesai...",
    }

    local progress = 0
    task.spawn(function()
        while progress < 100 do
            progress = math.min(100, progress + math.random(2, 7))
            BarFill.Size = UDim2.new(progress / 100, 0, 1, 0)
            PercentLbl.Text = tostring(progress) .. "%"
            local idx = math.min(#steps, math.floor(progress / 18) + 1)
            LoadStatus.Text = steps[idx]
            task.wait(0.05 + math.random() * 0.05)
        end
        task.wait(0.3)
        onDone()
    end)
end

ConfirmBtn.MouseButton1Click:Connect(function()
    local input = KeyBox.Text
    if input == "" then
        showStatus("Key tidak boleh kosong.", true)
        shake(LoginPage)
        return
    end
    if input ~= CONFIG.ValidKey then
        showStatus("Key salah. Coba lagi.", true)
        shake(LoginPage)
        return
    end
    showStatus("Key valid!", false)
    task.wait(0.4)
    runLoading(function()
        State.Authenticated = true
        LoadingPage.Visible = false
        MainUI.Visible = true
        ProfilePage.Visible = true
        CheatPage.Visible = false
        print("[DaimHUB] Login berhasil ✅")
        print("[DaimHUB] User:", LocalPlayer.Name)
    end)
end)

