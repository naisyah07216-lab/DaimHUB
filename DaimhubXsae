local EGG_KW = {"egg", "telur"}

local function hasEgg()
    local char = LocalPlayer.Character
    if not char then return false end
    local ok, result = pcall(function()
        -- cek Character
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") and nameMatch(c.Name, EGG_KW) then return true end
            if (c:IsA("Model") or c:IsA("BasePart")) and nameMatch(c.Name, EGG_KW) then
                return true
            end
        end
        -- cek Backpack
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        if bp then
            for _, c in ipairs(bp:GetChildren()) do
                if c:IsA("Tool") and nameMatch(c.Name, EGG_KW) then return true end
            end
        end
        return false
    end)
    return ok and result
end

local function smoothTeleport(targetPos)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if S.TPing then return end
    S.TPing = true

    local startPos = hrp.Position
    local dist = (targetPos - startPos).Magnitude
    local steps = math.max(1, math.ceil(dist / 100))
    local stepTime = 0.4 / steps

    task.spawn(function()
        pcall(function()
            for i = 1, steps do
                if not hrp or not hrp.Parent then break end
                local t = i / steps
                local stepPos = startPos:Lerp(targetPos, t)
                local tw = TweenService:Create(
                    hrp,
                    TweenInfo.new(stepTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    {CFrame = CFrame.new(stepPos)}
                )
                tw:Play()
                task.wait(stepTime)
            end
        end)
        S.TPing = false
    end)
end

local tpConn = nil
local function setTP(on)
    S.TPOn = on
    if on then
        if not tpConn then
            tpConn = RunService.Heartbeat:Connect(function()
                if not S.TPOn then return end
                if S.TPing then return end
                local now = tick()
                if now - S.LastTP < 1.0 then return end
                if not hasEgg() then return end
                S.LastTP = now
                print("[DaimHUB] 🥚 Egg detected → safe zone")
                smoothTeleport(CFG.SafeZone)
            end)
        end
        print("[DaimHUB] Egg Pick Teleportasi: ON")
    else
        if tpConn then tpConn:Disconnect() tpConn = nil end
        print("[DaimHUB] Egg Pick Teleportasi: OFF")
    end
end

