local function showStatus(text, isErr)
    StatusLbl.Text = text
    StatusLbl.TextColor3 = isErr and CONFIG.ErrorColor or CONFIG.SuccessColor
end

local function shake(inst)
    local og = inst.Position
    for i = 1, 4 do
        inst.Position = og + UDim2.fromOffset(8, 0)
        task.wait(0.04)
        inst.Position = og - UDim2.fromOffset(8, 0)
        task.wait(0.04)
    end
    inst.Position = og
end

local function runLoading(onDone)
    Login.Visible = false
    Loading.Visible = true

    local steps = {
        "Menghubungkan ke NEXORA...",
        "Memverifikasi key...",
        "Memuat modul...",
        "Sinkronisasi...",
        "Hampir selesai...",
    }

    local prog = 0
    task.spawn(function()
        while prog < 100 do
            prog = math.min(100, prog + math.random(3, 8))
            BarFill.Size = UDim2.new(prog / 100, 0, 1, 0)
            PercentLbl.Text = tostring(prog) .. "%"
            local i = math.min(#steps, math.floor(prog / 20) + 1)
            LoadStatus.Text = steps[i]
            task.wait(0.05 + math.random() * 0.05)
        end
        task.wait(0.3)
        onDone()
    end)
end

