local RARITY_KW = {"secret", "divine", "eternal", "mythic", "legendary"}

local function findRareEgg()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local closest, dist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and nameMatch(obj.Name, EGG_KW) then
            if nameMatch(obj.Name, RARITY_KW) then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    local d = (part.Position - hrp.Position).Magnitude
                    if d < dist then dist = d; closest = part end
                end
            end
        end
    end
    return closest
end

local autoConn = nil
local function setAutoSteal(on)
    S.AutoStealOn = on
    if on then
        if not autoConn then
            autoConn = RunService.Heartbeat:Connect(function()
                if not S.AutoStealOn then return end
                if not AntiDetect.Throttle("autosteal", 0.08) then return end
                local char = LocalPlayer.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local target = findRareEgg()
                if target then
                    local dist = (target.Position - hrp.Position).Magnitude
                    if dist > 3 then
                        local dir = (target.Position - hrp.Position).Unit
                        local move = dir * CFG.AutoFlySpeed * 0.1
                        local newCF = hrp.CFrame + move
                        AntiDetect.SmoothTeleport(hrp, newCF, 0.08)
                    else
                        AntiDetect.WaypointTeleport(hrp, S.SafeZone)
                        task.wait(0.3)
                    end
                end
            end)
        end
        print("[DaimHUB] Auto Steal: ON")
    else
        if autoConn then
            safeCall(function() autoConn:Disconnect() end)
            autoConn = nil
        end
        print("[DaimHUB] Auto Steal: OFF")
    end
end

MakeToggle(4, "✨", "AUTO STEAL", "Ambil egg rare → safe zone", setAutoSteal)

