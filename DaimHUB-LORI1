--============================================================
local function antiHitLoop()
    if not State.AntiHit then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if hum.Health < hum.MaxHealth then
        pcall(function() hum.Health = hum.MaxHealth end)
    end

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, gui in ipairs(pg:GetChildren()) do
            if gui:IsA("ScreenGui") then
                local nm = gui.Name:lower()
                if nm:find("jumpscare") or nm:find("death")
                or nm:find("gameover") then
                    gui.Enabled = false
                end
            end
        end
    end

    for _, s in ipairs(SoundService:GetDescendants()) do
        if s:IsA("Sound") and s.Playing then
            local nm = s.Name:lower()
            if nm:find("scare") or nm:find("scream") or nm:find("death") then
                pcall(function() s:Stop() end)
            end
        end
    end
end

local function setAntiHit(on)
    State.AntiHit = on
    if on then
        if not State.AntiHitConn then
            State.AntiHitConn = RunService.Heartbeat:Connect(antiHitLoop)
        end
    else
        if State.AntiHitConn then State.AntiHitConn:Disconnect() State.AntiHitConn = nil end
    end
end

MakeToggleRow(5, "❤  ANTI-HIT LORI", "Health auto-restore saat kena hit", setAntiHit)

