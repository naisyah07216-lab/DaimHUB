    for _, c in ipairs(char:GetChildren()) do
        if (c:IsA("Tool") or c:IsA("Model") or c:IsA("BasePart")) and nameMatch(c.Name, EGG_KW) then
            return true
        end
    end
    -- cek di backpack
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, c in ipairs(bp:GetChildren()) do
            if c:IsA("Tool") and nameMatch(c.Name, EGG_KW) then
                return true
            end
        end
    end
    -- cek di PlayerGui (kalau egg di-hold)
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, c in ipairs(pg:GetDescendants()) do
            if c:IsA("ImageLabel") or c:IsA("Frame") then
                if nameMatch(c.Name, EGG_KW) then
                    return true
                end
            end
        end
    end
    return false
end

