--============================================================
-- MAIN FITUR: ANTI-HIT GUARDIAN (4-Layer + Remote Block)
--============================================================
local function setGuard(on)
    S.GuardOn = on
    if on then
        print("[DaimHUB] 🛡️ Anti-Hit Guardian v1.2: ON")
        S.LockedHealth = nil
        scanAndFreeze()
        scanAndBlockRemotes()
        
        if not S.LoopConn then
            S.LoopConn = RunService.Heartbeat:Connect(function()
                if not S.GuardOn then return end
                local now = tick()
                
                if now - S.LastScan >= CFG.ScanInterval then
                    S.LastScan = now
                    pcall(scanAndFreeze)
                end
                if now - S.LastTouch >= CFG.TouchInterval then
                    S.LastTouch = now
                    pcall(blockDamageTouch)
                end
                if now - S.LastHealth >= CFG.HealthInterval then
                    S.LastHealth = now
                    pcall(healthLock)
                    pcall(scanAndBlockRemotes)
                end
                pcall(antiRagdoll)
            end)
        end
    else
        print("[DaimHUB] ⛔ Anti-Hit Guardian: OFF")
        if S.LoopConn then
            S.LoopConn:Disconnect()
            S.LoopConn = nil
        end
        for model, _ in pairs(S.Frozen) do
            if model and model.Parent then
                local hum = model:FindFirstChildOfClass("Humanoid")
                local hrp = model:FindFirstChild("HumanoidRootPart")
                if hum then
                    pcall(function()
                        hum.WalkSpeed = 16
                        hum.JumpPower = 50
                        hum.AutoRotate = true
                    end)
                end
                if hrp then pcall(function() hrp.Anchored = false end) end
                local hl = model:FindFirstChild("DaimGuard_HL")
                if hl then pcall(function() hl:Destroy() end) end
            end
        end
        S.Frozen = {}
        S.LockedHealth = nil
        unblockRemotes()
    end
end

