    Corner(row, 8)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -80, 0, 20)
    lbl.Position = UDim2.new(0, 14, 0, 8)
    lbl.BackgroundTransparency = 1
    lbl.Text = title
    lbl.TextColor3 = CONFIG.TextColor
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local dsc = Instance.new("TextLabel")
    dsc.Size = UDim2.new(1, -80, 0, 14)
    dsc.Position = UDim2.new(0, 14, 0, 28)
    dsc.BackgroundTransparency = 1
    dsc.Text = desc
    dsc.TextColor3 = CONFIG.MutedText
    dsc.Font = Enum.Font.Gotham
    dsc.TextSize = 10
    dsc.TextXAlignment = Enum.TextXAlignment.Left
    dsc.Parent = row

    local toggle = Instance.new("Frame")
    toggle.Size = UDim2.fromOffset(46, 24)
    toggle.Position = UDim2.new(1, -60, 0.5, -12)
    toggle.BackgroundColor3 = Color3.fromRGB(50, 45, 65)
    toggle.BorderSizePixel = 0
    toggle.Parent = row
    Corner(toggle, 12)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.Position = UDim2.new(0, 3, 0.5, -9)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.BorderSizePixel = 0
    knob.Parent = toggle
    Corner(knob, 9)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = row

    local state = false
    local function setVisual(on)
        state = on
        TweenService:Create(toggle, TweenInfo.new(0.2), {
            BackgroundColor3 = on and CONFIG.AccentColor or Color3.fromRGB(50, 45, 65)
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.2), {
            Position = on and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        }):Play()
    end

    btn.MouseButton1Click:Connect(function()
        setVisual(not state)
        if onToggle then onToggle(state) end
    end)

    return row, setVisual
end

--============================================================
-- TOGGLE 1: USP PORTAL TV
--============================================================
local TV_KW = {"tv", "television", "monitor", "screen", "repair", "generator"}

local function nameMatch(name, kws)
    local n = name:lower()
    for _, k in ipairs(kws) do
        if n:find(k) then return true end
    end
    return false
end

local function applyPortal(obj)
    if not State.PortalHighlights[obj] then
        local h = Instance.new("Highlight")
        h.Name = "DaimHUB_Portal"
        h.Adornee = obj
        h.FillColor = CONFIG.PortalColor
        h.OutlineColor = CONFIG.PortalColor
        h.FillTransparency = 0.3
        h.OutlineTransparency = 0.2
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = ScreenGui
        State.PortalHighlights[obj] = h
    end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BasePart") then
            d.LocalTransparencyModifier = 0.5
        end
    end
end

local function clearPortal()
    for obj, h in pairs(State.PortalHighlights) do
        pcall(function() h:Destroy() end)
    end
    State.PortalHighlights = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and nameMatch(obj.Name, TV_KW) then
            if obj:IsA("BasePart") then obj.LocalTransparencyModifier = 0 end
            for _, d in ipairs(obj:GetDescendants()) do
                if d:IsA("BasePart") then d.LocalTransparencyModifier = 0 end
            end
        end
    end
end

local function portalLoop()
    if not State.PortalActive then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and nameMatch(obj.Name, TV_KW) then
            applyPortal(obj)
        end
    end
    for obj, h in pairs(State.PortalHighlights) do
        if not obj.Parent then
            pcall(function() h:Destroy() end)
            State.PortalHighlights[obj] = nil
        end
    end
end

local function setPortal(on)
    State.PortalActive = on
    if on then
        if not State.PortalConn then
            State.PortalConn = RunService.Heartbeat:Connect(portalLoop)
        end
    else
        if State.PortalConn then
            State.PortalConn:Disconnect()
            State.PortalConn = nil
        end
        clearPortal()
    end
end

