--============================================================
-- PORTAL TV
--============================================================
local TV_KW = {"tv", "television", "monitor", "screen", "repair", "generator"}

local function applyPortal(obj)
    if S.PortalHL[obj] then return end
    local h = Instance.new("Highlight")
    h.Name = "DaimHUB_Portal"
    h.Adornee = obj
    h.FillColor = CONFIG.PortalColor
    h.OutlineColor = Color3.new(1,1,1)
    h.FillTransparency = 0.35
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = GUI
    S.PortalHL[obj] = h
end

local function clearPortal()
    for obj, h in pairs(S.PortalHL) do
        pcall(function() h:Destroy() end)
    end
    S.PortalHL = {}
end

local function portalLoop()
    if not S.PortalOn then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and nameMatch(obj.Name, TV_KW) then
            applyPortal(obj)
        end
    end
    for obj, h in pairs(S.PortalHL) do
        if not obj.Parent then
            pcall(function() h:Destroy() end)
            S.PortalHL[obj] = nil
        end
    end
end

local function setPortal(on)
    S.PortalOn = on
    if on then
        -- debug scan
        local count = 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            if (obj:IsA("Model") or obj:IsA("BasePart")) and nameMatch(obj.Name, TV_KW) then
                count = count + 1
                print("[DaimHUB] TV Found:", obj:GetFullName())
            end
        end
        print("[DaimHUB] Total TV:", count)
        if not S.PortalConn then
            S.PortalConn = RunService.Heartbeat:Connect(portalLoop)
        end
    else
        if S.PortalConn then
            S.PortalConn:Disconnect()
            S.PortalConn = nil
        end
        clearPortal()
    end
end

MakeToggle(2, "🌀  USP PORTAL TV", "TV tembus pandang (cek console)", setPortal)

