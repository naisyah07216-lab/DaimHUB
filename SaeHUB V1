local function isNPC(obj)
    if not obj or not obj:IsA("Model") then return false end
    if obj == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    local hum = obj:FindFirstChildOfClass("Humanoid")
    local hrp = obj:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end
    if hum.Health <= 0 then return false end
    return true
end

--============================================================
-- FREEZE NPC
--============================================================
local function freezeNPC(model)
    local hum = model:FindFirstChildOfClass("Humanoid")
    local hrp = model:FindFirstChild("HumanoidRootPart")
    
    if hum then
        pcall(function()
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum.JumpHeight = 0
            hum.AutoRotate = false
            hum.PlatformStand = false
        end)
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                pcall(function() track:Stop() end)
            end
        end
    end
    
    if hrp then
        pcall(function() hrp.Anchored = true end)
    end
    
    for _, c in ipairs(model:GetDescendants()) do
        if c:IsA("BodyVelocity") or c:IsA("BodyGyro")
        or c:IsA("AlignPosition") or c:IsA("AlignOrientation")
        or c:IsA("LinearVelocity") or c:IsA("VectorForce")
        or c:IsA("BodyForce") or c:IsA("BodyThrust") then
            pcall(function() c:Destroy() end)
        end
    end
    
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("Script") or d:IsA("LocalScript") then
            pcall(function() d.Disabled = true end)
        end
    end
    
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            pcall(function()
                d.CanTouch = false
                d.CanQuery = false
            end)
        end
    end
    
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("Tool") then
            pcall(function() d.Parent = nil end)
        end
    end
    
    if not model:FindFirstChild("DaimGuard_HL") then
        local h = Instance.new("Highlight")
        h.Name = "DaimGuard_HL"
        h.FillColor = CFG.Highlight
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.FillTransparency = 0.75
        h.OutlineTransparency = 0.3
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = model
    end
    
    S.Frozen[model] = true
end

local function reFreeze(model)
    if not model or not model.Parent then return end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            if hum.WalkSpeed ~= 0 then hum.WalkSpeed = 0 end
            if hum.JumpPower ~= 0 then hum.JumpPower = 0 end
        end)
    end
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if hrp and not hrp.Anchored then
        pcall(function() hrp.Anchored = true end)
    end
end

local function scanAndFreeze()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and isNPC(obj) then
            if not S.Frozen[obj] then
                freezeNPC(obj)
                print("[DaimHUB] ❄️ Frozen:", obj.Name)
            else
                reFreeze(obj)
            end
        end
    end
end

--============================================================
-- BLOCK TOUCH
--============================================================
local function blockDamageTouch()
    local char = LocalPlayer.Character
    if not char then return end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") and not d:IsDescendantOf(char) then
            local n = d.Name:lower()
            local isDamage = n:find("hit") or n:find("damage") 
                or n:find("kill") or n:find("punch") 
                or n:find("bite") or n:find("mouth") 
                or n:find("teeth") or n:find("attack")
                or n:find("touch") or n:find("hurt")
                or n:find("harm") or n:find("spike")
                or n:find("trap")
            
            local pm = d:FindFirstAncestorOfClass("Model")
            local isFromNPC = pm and pm:FindFirstChildOfClass("Humanoid")
                and not Players:GetPlayerFromCharacter(pm)
            
            if (isDamage or isFromNPC) and d.CanTouch then
                pcall(function()
                    d.CanTouch = false
                    d.CanQuery = false
                end)
            end
        end
    end
end

--============================================================
-- HEALTH LOCK
--============================================================
local function healthLock()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if not S.LockedHealth or S.LockedHealth < hum.MaxHealth then
        S.LockedHealth = hum.MaxHealth
    end
    if hum.Health < S.LockedHealth then
        pcall(function() hum.Health = S.LockedHealth end)
    end
end

--============================================================
-- ANTI-RAGDOLL
--============================================================
local function antiRagdoll()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Physics
        or st == Enum.HumanoidStateType.FallingDown
        or st == Enum.HumanoidStateType.Ragdoll then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
        if hum.PlatformStand then hum.PlatformStand = false end
        if hum.Sit then hum.Sit = false end
    end)
end

--============================================================
-- REMOTE SCANNER + BLOCK
--============================================================
local DMG_KEYWORDS = {
    "damage", "hit", "attack", "hurt", "kill", "death",
    "punch", "bite", "grab", "combat", "fight", "health"
}

local function nameMatchRemote(name, kws)
    if not name then return false end
    local n = name:lower()
    for _, k in ipairs(kws) do
        if n:find(k, 1, true) then return true end
    end
    return false
end

local function scanAndBlockRemotes()
    local count = 0
    for _, obj in ipairs(RS:GetDescendants()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction"))
        and not S.BlockedRemotes[obj] then
            if nameMatchRemote(obj.Name, DMG_KEYWORDS) then
                if obj:IsA("RemoteEvent") then
                    pcall(function()
                        obj.OnClientEvent:Connect(function() end)
                    end)
                end
                S.BlockedRemotes[obj] = true
                count = count + 1
                print("[DaimHUB] 🚫 Blocked remote:", obj.Name)
            end
        end
    end
    if count > 0 then
        print("[DaimHUB] Total blocked remotes:", count)
    end
end

local function unblockRemotes()
    S.BlockedRemotes = {}
end

