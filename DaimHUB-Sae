local function nameMatch(name, kws)
    if not name or not kws then return false end
    local n = string.lower(name)
    for _, k in ipairs(kws) do
        if string.find(n, k, 1, true) then return true end
    end
    return false
end

local function safeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[DaimHUB] Error:", err)
    end
    return ok
end

local function round(inst, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 10)
    c.Parent = inst
    return c
end

local function stroke(inst, color, thick, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or CFG.Accent2
    s.Thickness = thick or 1.5
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = inst
    return s
end

local function gradient(inst, c1, c2, c3, rotation)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, c1),
        ColorSequenceKeypoint.new(0.50, c2 or c1),
        ColorSequenceKeypoint.new(1.00, c3 or c2 or c1),
    })
    g.Rotation = rotation or 45
    g.Parent = inst
    return g
end

local function animatedGradient(inst)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, CFG.Accent1),
        ColorSequenceKeypoint.new(0.33, CFG.Accent2),
        ColorSequenceKeypoint.new(0.66, CFG.Accent1),
        ColorSequenceKeypoint.new(1.00, CFG.Accent3),
    })
    g.Rotation = 0
    g.Parent = inst

    task.spawn(function()
        local rot = 0
        while g and g.Parent and g.Parent.Parent do
            rot = (rot + 1) % 360
            safeCall(function() g.Rotation = rot end)
            task.wait(0.03)
        end
    end)
    return g
end

local function pulse(inst, strokeInst, minOp, maxOp, speed)
    if not strokeInst then return end
    speed = speed or 1
    task.spawn(function()
        while strokeInst and strokeInst.Parent do
            safeCall(function()
                TweenService:Create(strokeInst, TweenInfo.new(speed), {Transparency = maxOp or 0.6}):Play()
            end)
            task.wait(speed)
            safeCall(function()
                TweenService:Create(strokeInst, TweenInfo.new(speed), {Transparency = minOp or 0}):Play()
            end)
            task.wait(speed)
        end
    end)
end

