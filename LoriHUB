local function ahLoop()
    if not S.AHon then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if hum.Health < hum.MaxHealth then
        pcall(function() hum.Health = hum.MaxHealth end)
    end

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, gui in ipairs(pg:GetChildren()) do
            if gui:IsA("ScreenGui") then
                local nm = gui.Name:lower()
                if nm:find("jumpscare") or nm:find("death") or nm:find("gameover") then
                    gui.Enabled = false
                end
            end
        end
    end
end

local function setAH(on)
    S.AHon = on
    if on then
        if not S.AHconn then
            S.AHconn = RunService.Heartbeat:Connect(ahLoop)
        end
    else
        if S.AHconn then S.AHconn:Disconnect() S.AHconn = nil end
    end
end

