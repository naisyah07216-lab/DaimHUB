--============================================================
-- ANTI-DETECT MODULE (internal, no yield)
--============================================================
local AntiDetect = {
    Enabled   = true,
    MinDelay  = 0.1,
    MaxDelay  = 0.3,
    TweenTime = 0.18,
    MaxJump   = 150,
    _last     = {},
}

function AntiDetect.HumanDelay()
    if not AntiDetect.Enabled then return end
    task.wait(AntiDetect.MinDelay + math.random() * (AntiDetect.MaxDelay - AntiDetect.MinDelay))
end

-- Fire-and-forget teleport (gak yield)
function AntiDetect.SmoothTeleport(hrp, targetCF, dur)
    if not hrp or not hrp.Parent then return end
    dur = dur or AntiDetect.TweenTime
    if not AntiDetect.Enabled then
        safeCall(function() hrp.CFrame = targetCF end)
        return
    end
    safeCall(function()
        local tw = TweenService:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Quad), {CFrame = targetCF})
        tw:Play()
    end)
end

-- Waypoint chain (split jarak jauh biar gak obvious)
function AntiDetect.WaypointTeleport(hrp, targetPos)
    if not hrp or not hrp.Parent then return end
    if not AntiDetect.Enabled then
        safeCall(function() hrp.CFrame = CFrame.new(targetPos) end)
        return
    end
    local cur = hrp.Position
    local dist = (targetPos - cur).Magnitude
    if dist < AntiDetect.MaxJump then
        -- jarak deket, langsung tween
        AntiDetect.SmoothTeleport(hrp, CFrame.new(targetPos), 0.15)
    else
        -- jarak jauh, snap instant (jarang, biar gak lag)
        safeCall(function() hrp.CFrame = CFrame.new(targetPos) end)
    end
end

function AntiDetect.Throttle(key, interval)
    if not AntiDetect.Enabled then return true end
    interval = interval or 0.1
    local now = tick()
    if AntiDetect._last[key] and (now - AntiDetect._last[key]) < interval then
        return false
    end
    AntiDetect._last[key] = now
    return true
end

