local function antiKnockback()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")

    local vel = hrp.Velocity
    if vel.Magnitude > CFG.MaxSpeed then
        local newVel
        if hum and hum.MoveDirection.Magnitude > 0 then
            newVel = hum.MoveDirection * hum.WalkSpeed
            newVel = Vector3.new(newVel.X, vel.Y, newVel.Z)
        else
            newVel = Vector3.new(0, vel.Y, 0)
        end
        pcall(function() hrp.Velocity = newVel end)
    end

    -- hapus BodyMover asing
    for _, c in ipairs(hrp:GetChildren()) do
        if c:IsA("BodyVelocity") or c:IsA("BodyForce") or c:IsA("BodyThrust") then
            pcall(function() c:Destroy() end)
        end
        if c:IsA("Attachment") then
            for _, f in ipairs(c:GetChildren()) do
                if f:IsA("LinearVelocity") or f:IsA("VectorForce") then
                    pcall(function() f:Destroy() end)
                end
            end
        end
    end
end

local kbConn = nil
local function setKB(on)
    S.KBOn = on
    if on then
        if not kbConn then
            kbConn = RunService.Heartbeat:Connect(function()
                if not S.KBOn then return end
                pcall(antiKnockback)
            end)
        end
        print("[DaimHUB] Anti-Knockback: ON")
    else
        if kbConn then kbConn:Disconnect() kbConn = nil end
        print("[DaimHUB] Anti-Knockback: OFF")
    end
end

