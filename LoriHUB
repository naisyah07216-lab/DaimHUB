--============================================================
local function arLoop()
    if not S.ARon then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
    end)

    pcall(function()
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Physics
        or st == Enum.HumanoidStateType.FallingDown then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
        if hum.PlatformStand then hum.PlatformStand = false end
        if hum.Sit then hum.Sit = false end
    end)

    for _, c in ipairs(char:GetDescendants()) do
        if c:IsA("BallSocketConstraint")
        or c:IsA("RopeConstraint")
        or c:IsA("HingeConstraint") then
            pcall(function() c:Destroy() end)
        end
    end
end

local function setAR(on)
    S.ARon = on
    if on then
        if not S.ARconn then
            S.ARconn = RunService.Heartbeat:Connect(arLoop)
        end
    else
        if S.ARconn then S.ARconn:Disconnect() S.ARconn = nil end
    end
end

MakeToggle(4, "🛡  ANTI-RAGDOLL", "Gak jatuh saat di-hit", setAR)

