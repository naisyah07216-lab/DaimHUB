--============================================================
local function antiRagdollLoop()
    if not State.AntiRagdoll then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
    end)

    pcall(function()
        if hum:GetState() == Enum.HumanoidStateType.Physics
        or hum:GetState() == Enum.HumanoidStateType.FallingDown then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
        if hum.PlatformStand then hum.PlatformStand = false end
        if hum.Sit then hum.Sit = false end
    end)

    for _, c in ipairs(char:GetDescendants()) do
        if c:IsA("BallSocketConstraint") or c:IsA("RopeConstraint")
        or c:IsA("HingeConstraint") then
            pcall(function() c:Destroy() end)
        end
    end

    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            local nm = (track.Animation and track.Animation.Name or ""):lower()
            if nm:find("ragdoll") or nm:find("fall")
            or nm:find("down") or nm:find("hit") or nm:find("stun") then
                pcall(function() track:Stop() end)
            end
        end
    end
end

local function setAntiRagdoll(on)
    State.AntiRagdoll = on
    if on then
        if not State.AntiRagConn then
            State.AntiRagConn = RunService.Heartbeat:Connect(antiRagdollLoop)
        end
    else
        if State.AntiRagConn then State.AntiRagConn:Disconnect() State.AntiRagConn = nil end
    end
end

MakeToggleRow(4, "🛡  ANTI-RAGDOLL", "Gak jatuh / kelenger saat di-hit", setAntiRagdoll)

