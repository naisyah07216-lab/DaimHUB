        if not S.NCconn then
            S.NCconn = RunService.Stepped:Connect(ncLoop)
        end
    else
        if S.NCconn then S.NCconn:Disconnect() S.NCconn = nil end
        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = true end
            end
        end
    end
end

