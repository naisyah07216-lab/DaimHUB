--============================================================
-- FLY LOGIC
--============================================================
local function clampSpeed(v)
    v = tonumber(v) or 50
    if v < CONFIG.MinSpeed then v = CONFIG.MinSpeed end
    if v > CONFIG.MaxSpeed then v = CONFIG.MaxSpeed end
    return v
end

local function updateSpeedUI(v)
    S.FlySpeed = v
    SpeedBox.Text = tostring(v)
    SpeedTitle.Text = "KECEPATAN: " .. tostring(v)
    SpeedFill.Size = UDim2.new(v / CONFIG.MaxSpeed, 0, 1, 0)
end

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if S.FlyBV then pcall(function() S.FlyBV:Destroy() end) end
    if S.FlyBG then pcall(function() S.FlyBG:Destroy() end) end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "DaimHUB_FlyBV"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp
    S.FlyBV = bv

    local bg = Instance.new("BodyGyro")
    bg.Name = "DaimHUB_FlyBG"
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 1000
    bg.D = 50
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp
    S.FlyBG = bg

    hum.PlatformStand = true

    if S.FlyConn then pcall(function() S.FlyConn:Disconnect() end) end
    S.FlyConn = RunService.RenderStepped:Connect(function()
        if not S.FlyOn then return end
        local c = LocalPlayer.Character
        if not c then return end
        local r = c:FindFirstChild("HumanoidRootPart")
        if not r or not S.FlyBV then return end

        local cam = workspace.CurrentCamera
        local mv = Vector3.zero
        local sp = S.FlySpeed

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv = mv + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv = mv - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv = mv - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv = mv + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv = mv + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then mv = mv - Vector3.new(0,1,0) end

        S.FlyBV.Velocity = mv.Magnitude > 0 and mv.Unit * sp or Vector3.zero
        if S.FlyBG then S.FlyBG.CFrame = cam.CFrame end
    end)
end

local function stopFly()
    if S.FlyConn then pcall(function() S.FlyConn:Disconnect() end) S.FlyConn = nil end
    if S.FlyBV then pcall(function() S.FlyBV:Destroy() end) S.FlyBV = nil end
    if S.FlyBG then pcall(function() S.FlyBG:Destroy() end) S.FlyBG = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

local function setFly(on)
    S.FlyOn = on
    if on then
        startFly()
        TweenService:Create(FlyTog, TweenInfo.new(0.2), {BackgroundColor3 = CONFIG.AccentColor}):Play()
        TweenService:Create(FlyKnob, TweenInfo.new(0.2), {Position = UDim2.new(1, -19, 0.5, -8)}):Play()
    else
        stopFly()
        TweenService:Create(FlyTog, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 45, 65)}):Play()
        TweenService:Create(FlyKnob, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -8)}):Play()
    end
end

