local function round(inst, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 10)
    c.Parent = inst
    return c
end

local function stroke(inst, color, thick, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or CFG.Accent2
    s.Thickness = thick or 1.5
    s.Transparency = transparency or 0
    s.Parent = inst
    return s
end

local function gradient(inst, c1, c2, c3, rotation)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, c1),
        ColorSequenceKeypoint.new(0.50, c2 or c1),
        ColorSequenceKeypoint.new(1.00, c3 or c2 or c1),
    })
    g.Rotation = rotation or 45
    g.Parent = inst
    return g
end

local function rainbowGradient(inst)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 100, 100)),
        ColorSequenceKeypoint.new(0.20, Color3.fromRGB(255, 200, 80)),
        ColorSequenceKeypoint.new(0.40, Color3.fromRGB(100, 255, 120)),
        ColorSequenceKeypoint.new(0.60, Color3.fromRGB(100, 200, 255)),
        ColorSequenceKeypoint.new(0.80, Color3.fromRGB(200, 120, 255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 100, 100)),
    })
    g.Rotation = 0
    g.Parent = inst
    task.spawn(function()
        local rot = 0
        while g.Parent and g.Parent.Parent do
            rot = (rot + 2) % 360
            pcall(function() g.Rotation = rot end)
            task.wait(0.03)
        end
    end)
    return g
end

